# Supabase Postgres connection string, pooled/transaction-mode port (see Supabase project settings > Database).
# SQLAlchemy async driver prefix is required: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase project URL and service-role key (backend is fully trusted in v1 - no auth/RLS yet).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_RAW_UPLOADS_BUCKET=raw-uploads
SUPABASE_ASSETS_BUCKET=submission-assets

# LLM provider selection - swap LLM_PROVIDER/LLM_MODEL to change models without code changes.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-key
LLM_MAX_IMAGES_PER_SUBMISSION=6
LLM_TIMEOUT_SECONDS=60

# Background evaluation-run reconciliation sweep (picks up stale pending/running jobs).
RECONCILIATION_SWEEP_INTERVAL_SECONDS=45
RUN_STALE_THRESHOLD_SECONDS=600

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
